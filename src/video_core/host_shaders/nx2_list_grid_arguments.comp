#version 450

// A kept command list's grid words (nx2_list_grid.h) as the dispatch arguments
// KeplerCompute::DispatchNativeCompute would take from a QMD: x as 31 bits, y and z as 16.

layout(local_size_x = 1) in;

layout(std430, binding = 0) readonly buffer Words {
    uint words[];
};

layout(std430, binding = 1) writeonly buffer Arguments {
    uint arguments[];
};

layout(push_constant) uniform PushConstants {
    uint word_index;
    uint argument_index;
    uint max_x;
    uint max_y;
    uint max_z;
};

void main() {
    const uint gx = words[word_index] & 0x7fffffffu;
    const uint gy = words[word_index + 1u] & 0xffffu;
    const uint gz = words[word_index + 2u] & 0xffffu;
    const bool fits = gx <= max_x && gy <= max_y && gz <= max_z;
    arguments[argument_index] = fits ? gx : 0u;
    arguments[argument_index + 1u] = fits ? gy : 0u;
    arguments[argument_index + 2u] = fits ? gz : 0u;
}
