#version 450 core

layout(local_size_x = 128) in;

layout(std430, set = 0, binding = 0) readonly buffer InputBuffer {
    uint input_words[];
};

layout(std430, set = 0, binding = 1) writeonly buffer OutputBuffer {
    uint output_words[];
};

layout(push_constant) uniform PushConstants {
    uint index_count;
    uint restart_index;
};

uint WidenIndex(uint index) {
    return index == restart_index ? 0xffff : index;
}

void main() {
    uint count = index_count / 2 + index_count % 2;
    uint step = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    // Each invocation owns one output word. The host can cap the grid to device limits.
    for (uint word = gl_GlobalInvocationID.x; word < count; word += step) {
        uint input_pair = input_words[word / 2] >> ((word % 2) * 16);
        uint packed = WidenIndex(input_pair & 0xff);
        if (word * 2 + 1 < index_count) {
            packed |= WidenIndex((input_pair >> 8) & 0xff) << 16;
        }
        output_words[word] = packed;
        if (step >= count - word) break;
    }
}
