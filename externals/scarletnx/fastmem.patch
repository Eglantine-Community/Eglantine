diff --git a/src/common/cpu/recompiler/llvm/ir_state.c b/src/common/cpu/recompiler/llvm/ir_state.c
--- a/src/common/cpu/recompiler/llvm/ir_state.c
+++ b/src/common/cpu/recompiler/llvm/ir_state.c
@@ -246,4 +246,9 @@
 LLVMValueRef ir_mp(SnxIr* ir, LLVMValueRef address) {
-    LLVMValueRef index = ir_u64(ir, address);
+    /* Follow Eglantine's address normalization, then keep the access in the fastmem arena.
+       Page zero is unmapped; the last page is excluded so a wide transfer cannot straddle the arena. */
+    LLVMValueRef index = LLVMBuildAnd(ir->b, ir_u64(ir, address), ir_i64(ir, 0xffffffffffffULL), "");
+    LLVMValueRef valid =
+        LLVMBuildICmp(ir->b, LLVMIntULT, index, ir_i64(ir, (1ULL << 39) - 4096), "");
+    index = LLVMBuildSelect(ir->b, valid, index, ir_i64(ir, 0), "");
     return LLVMBuildGEP2(ir->b, ir->t_i8, ir->M, &index, 1, "");
 }
