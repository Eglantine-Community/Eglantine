+/* SPDX-License-Identifier: GPL-3.0-or-later
+   Copyright 2026 Eglantine Emulator Project */
+#ifndef SNX_FRESH_IMAGE_H
+#define SNX_FRESH_IMAGE_H
+
+#include "common/cpu/recompiler/llvm/link.h"
+
+#if defined(__linux__) && defined(__x86_64__) && !defined(__ILP32__) && !defined(__ANDROID__)
+#define SNX_FRESH_IMAGE_SUPPORTED 1
+
+typedef struct {
+    unsigned char* base;
+    size_t size;
+} SnxFreshImage;
+
+/* A failed personality query is not proof that readable pages are nonexecutable. */
+int snx_fresh_image_policy_safe(void);
+
+/* Only for the current call's linker output. No ELF headers, names or disk input are read.
+   image must be empty on entry and remains empty on failure. */
+int snx_fresh_image_load(const SnxLinkOutput* linked, SnxFreshImage* image);
+void snx_fresh_image_unload(SnxFreshImage* image);
+
+/* Check that a nonempty host range belongs to one of the image's logical segments. */
+int snx_fresh_image_contains(const SnxFreshImage* image, const void* address, size_t size,
+                             size_t segment, size_t segment_size);
+#endif
+#endif
--- a/src/common/cpu/recompiler/llvm/fresh_image.c
+++ b/src/common/cpu/recompiler/llvm/fresh_image.c
@@ -0,0 +1,106 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+   Copyright 2026 Eglantine Emulator Project */
+#if defined(__linux__) && !defined(_GNU_SOURCE)
+#define _GNU_SOURCE
+#endif
+#include "common/cpu/recompiler/llvm/fresh_image.h"
+
+#ifdef SNX_FRESH_IMAGE_SUPPORTED
+#include "common/cpu/recompiler/llvm/elf_defs.h"
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/personality.h>
+#include <unistd.h>
+
+#define PAGE_SIZE_BYTES ((size_t)4096)
+#define MAX_IMAGE_BYTES ((size_t)64 << 20)
+
+static int fits(size_t offset, size_t size, size_t limit) {
+    return offset <= limit && size <= limit - offset;
+}
+
+static int within(size_t offset, size_t size, size_t start, size_t length) {
+    return offset >= start && fits(offset - start, size, length);
+}
+
+static size_t round_page(size_t size) {
+    return (size + PAGE_SIZE_BYTES - 1) & ~(PAGE_SIZE_BYTES - 1);
+}
+
+int snx_fresh_image_contains(const SnxFreshImage* image, const void* address, size_t size,
+                             size_t segment, size_t segment_size) {
+    uintptr_t base = (uintptr_t)image->base, ptr = (uintptr_t)address;
+    return image->base && size && fits(segment, segment_size, image->size) && ptr >= base &&
+           within(ptr - base, size, segment, segment_size);
+}
+
+static int valid_layout(const SnxLinkOutput* linked) {
+    const SnxFreshLayout* l = &linked->fresh;
+    /* Accept only three adjacent page ranges, R/RX/RW. */
+    return linked->data && l->r_size && l->rx_size && l->rw_file_size &&
+           l->r_size <= MAX_IMAGE_BYTES && l->r_size <= linked->size &&
+           fits(l->rx_offset, l->rx_size, MAX_IMAGE_BYTES) &&
+           fits(l->rx_offset, l->rx_size, linked->size) &&
+           fits(l->rw_offset, l->rw_mem_size, MAX_IMAGE_BYTES) &&
+           fits(l->rw_offset, l->rw_file_size, linked->size) &&
+           l->rx_offset == round_page(l->r_size) &&
+           l->rw_offset == round_page(l->rx_offset + l->rx_size) &&
+           l->rw_reloc_size <= l->rw_file_size && l->rw_file_size <= l->rw_mem_size &&
+           l->rela_offset <= l->r_size && l->rela_count <= (l->r_size - l->rela_offset) / sizeof(Elf64_Rela) &&
+           within(l->descriptor, 1, l->rx_offset, l->rx_size);
+}
+
+static int relocate(const SnxLinkOutput* linked, unsigned char* base) {
+    const SnxFreshLayout* l = &linked->fresh;
+    size_t i;
+    for (i = 0; i < l->rela_count; ++i) {
+        Elf64_Rela r;
+        size_t target;
+        memcpy(&r, linked->data + l->rela_offset + i * sizeof(r), sizeof(r));
+        if (r.r_info != ELF64_R_INFO(0, R_X86_64_RELATIVE) || r.r_addend <= 0 ||
+            r.r_offset % sizeof(uint64_t) ||
+            !within(r.r_offset, sizeof(uint64_t), l->rw_offset, l->rw_reloc_size))
+            return -1;
+        target = (size_t)r.r_addend;
+        if (target >= l->r_size && !within(target, 1, l->rx_offset, l->rx_size) &&
+            !within(target, 1, l->rw_offset, l->rw_mem_size))
+            return -1;
+        snx_link_put64(base + r.r_offset, (uintptr_t)(base + target));
+    }
+    return 0;
+}
+
+int snx_fresh_image_policy_safe(void) {
+    const int flags = personality(0xffffffffUL);
+    return flags >= 0 && !(flags & READ_IMPLIES_EXEC);
+}
+
+int snx_fresh_image_load(const SnxLinkOutput* linked, SnxFreshImage* image) {
+    const SnxFreshLayout* l = &linked->fresh;
+    unsigned char* base;
+    size_t size;
+    if (image->base || image->size || !valid_layout(linked) ||
+        sysconf(_SC_PAGESIZE) != PAGE_SIZE_BYTES || !snx_fresh_image_policy_safe())
+        return -1;
+    size = round_page(l->rw_offset + l->rw_mem_size);
+    base = mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (base == MAP_FAILED) return -1;
+    memcpy(base, linked->data, l->r_size);
+    memcpy(base + l->rx_offset, linked->data + l->rx_offset, l->rx_size);
+    memcpy(base + l->rw_offset, linked->data + l->rw_offset, l->rw_file_size);
+    if (relocate(linked, base) ||
+        mprotect(base, l->rx_offset, PROT_READ) ||
+        mprotect(base + l->rx_offset, l->rw_offset - l->rx_offset, PROT_READ | PROT_EXEC)) {
+        munmap(base, size);
+        return -1;
+    }
+    image->base = base;
+    image->size = size;
+    return 0;
+}
+
+void snx_fresh_image_unload(SnxFreshImage* image) {
+    if (image->size) munmap(image->base, image->size);
+    memset(image, 0, sizeof(*image));
+}
+#endif
