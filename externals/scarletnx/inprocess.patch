+#ifdef SNX_FRESH_IMAGE_SUPPORTED
+static int checked_descriptor(const SnxFreshImage* image, const SnxFreshLayout* layout,
+                              const struct snx_recompiled* m, const Descriptor* d) {
+    size_t i;
+    const size_t rw = layout->rw_offset;
+    if ((uintptr_t)d % sizeof(uint64_t) ||
+        !snx_fresh_image_contains(image, d, sizeof(*d), rw, layout->rw_mem_size) ||
+        d->abi != SNX_ABI || d->reserved || d->interp || !d->count ||
+        d->count > (m->code_hi - m->code_lo) / 4 || d->count > SIZE_MAX / sizeof(GuestFn) ||
+        (uintptr_t)d->addresses % sizeof(uint64_t) || (uintptr_t)d->functions % sizeof(GuestFn) ||
+        !snx_fresh_image_contains(image, d->addresses, d->count * sizeof(uint64_t), 0, layout->r_size) ||
+        !snx_fresh_image_contains(image, d->functions, d->count * sizeof(GuestFn), rw, layout->rw_reloc_size))
+        return 0;
+    if (m->hook_direct_calls) {
+        if (!snx_fresh_image_contains(image, d->stale, m->functions, rw, layout->rw_mem_size)) return 0;
+    } else if (d->stale) {
+        return 0;
+    }
+    for (i = 0; i < d->count; ++i) {
+        uint64_t address = d->addresses[i];
+        if (address < m->code_lo || address >= m->code_hi || (address & 3) ||
+            (i && address <= d->addresses[i - 1]) ||
+            !snx_fresh_image_contains(image, (const void*)(uintptr_t)d->functions[i], 1,
+                                      layout->rx_offset, layout->rx_size))
+            return 0;
+    }
+    return 1;
+}
+
+static int try_fresh_image(struct snx_recompiler* r, struct snx_recompiled* m, const SnxLinkOutput* linked) {
+    SnxFreshImage image = {0};
+    double start = profile_now(r);
+    int rc = snx_fresh_image_load(linked, &image);
+    profile_end(r, SNX_PROFILE_INPROCESS_MAP, start, image.size, !rc);
+    if (rc) {
+        fail(r, "fresh incremental image failed mapping or protection validation");
+        return -1;
+    }
+    {
+        DescriptorFn describe = (DescriptorFn)(uintptr_t)(image.base + linked->fresh.descriptor);
+        const Descriptor* d;
+        start = profile_now(r);
+        d = describe();
+        if (!checked_descriptor(&image, &linked->fresh, m, d)) {
+            fail(r, "fresh incremental image has an invalid descriptor");
+            rc = -1;
+        } else {
+            rc = load_descriptor(r, m, d);
+        }
+        profile_end(r, SNX_PROFILE_INPROCESS_DESCRIPTOR, start, 0, !rc);
+    }
+    if (!rc)
+        m->fresh_image = image;
+    else
+        snx_fresh_image_unload(&image);
+    return rc;
+}
+#endif
+
+static int load_linked(struct snx_recompiler* r, struct snx_recompiled* m, const SnxLinkOutput* linked,
+                       int incremental, int* described) {
+    const double start = profile_now(r);
+    int rc;
+    *described = 0;
+#ifdef SNX_FRESH_IMAGE_SUPPORTED
+    if (incremental && r->inprocess_delta_loader) {
+        const double attempt = profile_now(r);
+        rc = try_fresh_image(r, m, linked);
+        profile_end(r, SNX_PROFILE_INPROCESS_LOAD, attempt, 0, !rc);
+        *described = !rc;
+        profile_end(r, SNX_PROFILE_IMAGE_LOAD, start, 0, !rc);
+        return rc;
+    }
+#else
+    (void)incremental;
+#endif
+    rc = load_image_impl(r, m, linked->data, linked->size);
+    profile_end(r, SNX_PROFILE_IMAGE_LOAD, start, 0, !rc);
+    return rc;
+}
