+/* Embedder timings: host wall nanoseconds and I/O bytes (zero for non-I/O stages).
+   CACHE_LOOKUP includes CACHE_READ and any CACHE_IMAGE_LOAD. CACHE_IMAGE_LOAD and IMAGE_LOAD
+   (newly linked modules) both include IMAGE_WRITE and DLOPEN.
+   LLVM_METADATA includes RTLIB, which includes RTLIB_CACHE_READ and RTLIB_CACHE_WRITE.
+   A successful CACHE_LOOKUP means the cached module was loaded and accepted. Writes report
+   requested bytes; reads report bytes returned. Discovery timings cover snx_recompile_from.
+   The callback runs on the caller's thread and must not reenter the recompiler. NULL disables it. */
+enum snx_profile_stage {
+    SNX_PROFILE_DISCOVERY,
+    SNX_PROFILE_CACHE_LOOKUP,
+    SNX_PROFILE_CACHE_READ,
+    SNX_PROFILE_CACHE_IMAGE_LOAD,
+    SNX_PROFILE_LLVM_INIT,
+    SNX_PROFILE_LLVM_UNITS,
+    SNX_PROFILE_LLVM_METADATA,
+    SNX_PROFILE_RTLIB,
+    SNX_PROFILE_RTLIB_CACHE_READ,
+    SNX_PROFILE_RTLIB_CACHE_WRITE,
+    SNX_PROFILE_LINK,
+    SNX_PROFILE_IMAGE_LOAD,
+    SNX_PROFILE_IMAGE_WRITE,
+    SNX_PROFILE_DLOPEN,
+    SNX_PROFILE_CACHE_WRITE,
+    SNX_PROFILE_STAGE_COUNT,
+};
+typedef void (*snx_profile_fn)(void* context, enum snx_profile_stage stage, uint64_t ns,
+                               uint64_t bytes, int success);
+SNX_RECOMPILER_API void snx_recompiler_set_profile(struct snx_recompiler* r, snx_profile_fn fn,
+                                                   void* context);
 /* A folder the generated code's text (LLVM IR as .ll) is saved in, for inspection; NULL (the
    default) saves nothing. The string is copied */
 SNX_RECOMPILER_API int snx_recompiler_set_keep_ir(struct snx_recompiler* r, const char* folder);
